{
  "name": "naga-privy-pay",
  "private": true,
  "description": "Builds assets/vendor/privy-pay.js: Privy wallet connect + USDC (Solana) payment, loaded on demand by naga-store.js. Kept apart from the site's package.json so deploys stay light.",
  "scripts": {
    "build": "rm -rf ../../assets/vendor/privy && esbuild privy-pay.jsx --bundle --splitting --format=esm --minify --platform=browser --target=es2020 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --define:global=globalThis --legal-comments=none --chunk-names=chunk-[hash] --outdir=../../assets/vendor/privy",
    "test": "node transfer.test.mjs"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.51.3",
    "@solana-program/memo": "0.10.0",
    "@solana-program/system": "0.10.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  }
}
