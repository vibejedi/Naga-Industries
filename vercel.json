{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/llms.txt", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] }
  ]
}
